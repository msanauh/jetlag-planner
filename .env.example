# --- Avisos push en Vercel (Settings → Environment Variables) ---
# Claves VAPID: genéralas una vez con `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios push (Apple/Google), p. ej. mailto:tu-correo@ejemplo.com
VAPID_SUBJECT=
# La misma clave pública, visible para la app (se incrusta al compilar).
VITE_VAPID_PUBLIC_KEY=
# Secreto que debe enviar quien llame a /api/tick (la planificación de QStash).
CRON_SECRET=
# Upstash Redis: los pone solos la integración de Vercel Marketplace (KV_REST_API_URL / KV_REST_API_TOKEN).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Solo si la API se aloja en otro dominio (por defecto, /api del mismo sitio).
# VITE_PUSH_API=
